{"1":{"w":[{"c":"قُلْ","d":"qul","e":"Say"},{"c":"هُوَ","d":"huwa","e":"He"},{"c":"اللَّهُ","d":"l-lahu","e":"(is) Allah"},{"c":"أَحَدٌ","d":"aḥadun","e":"the One"}],"a":{"g":"Say, \"He is Allah, [who is] One,"}},"2":{"w":[{"c":"اللَّهُ","d":"al-lahu","e":"Allah"},{"c":"الصَّمَدُ","d":"l-ṣamadu","e":"the Eternal the Absolute"}],"a":{"g":"Allah, the Eternal Refuge."}},"3":{"w":[{"c":"لَمْ","d":"lam","e":"Not"},{"c":"يَلِدْ","d":"yalid","e":"He begets"},{"c":"وَلَمْ","d":"walam","e":"and not"},{"c":"يُولَدْ","d":"yūlad","e":"He is begotten"}],"a":{"g":"He neither begets nor is born,"}},"4":{"w":[{"c":"وَلَمْ","d":"walam","e":"And not"},{"c":"يَكُنْ","d":"yakun","e":"is"},{"c":"لَهُ","d":"lahu","e":"for Him"},{"c":"كُفُوًا","d":"kufuwan","e":"equivalent"},{"c":"أَحَدٌ","d":"aḥadun","e":"any [one]"}],"a":{"g":"Nor is there to Him any equivalent.\""}}}