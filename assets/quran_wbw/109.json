{"1":{"w":[{"c":"قُلْ","d":"qul","e":"Say"},{"c":"يَاأَيُّهَا","d":"yāayyuhā","e":"O"},{"c":"الْكَافِرُونَ","d":"l-kāfirūna","e":"disbelievers"}],"a":{"g":"Say, \"O disbelievers,"}},"2":{"w":[{"c":"لَا","d":"lā","e":"Not"},{"c":"أَعْبُدُ","d":"aʿbudu","e":"I worship"},{"c":"مَا","d":"mā","e":"what"},{"c":"تَعْبُدُونَ","d":"taʿbudūna","e":"you worship"}],"a":{"g":"I do not worship what you worship."}},"3":{"w":[{"c":"وَلَا","d":"walā","e":"And not"},{"c":"أَنْتُمْ","d":"antum","e":"you"},{"c":"عَابِدُونَ","d":"ʿābidūna","e":"(are) worshippers"},{"c":"مَا","d":"mā","e":"(of) what"},{"c":"أَعْبُدُ","d":"aʿbudu","e":"I worship"}],"a":{"g":"Nor are you worshippers of what I worship."}},"4":{"w":[{"c":"وَلَا","d":"walā","e":"And not"},{"c":"أَنَا","d":"anā","e":"I am"},{"c":"عَابِدٌ","d":"ʿābidun","e":"a worshipper"},{"c":"مَا","d":"mā","e":"(of) what"},{"c":"عَبَدْتُمْ","d":"ʿabadttum","e":"you worship"}],"a":{"g":"Nor will I be a worshipper of what you worship."}},"5":{"w":[{"c":"وَلَا","d":"walā","e":"And not"},{"c":"أَنْتُمْ","d":"antum","e":"you are"},{"c":"عَابِدُونَ","d":"ʿābidūna","e":"worshippers"},{"c":"مَا","d":"mā","e":"(of) what"},{"c":"أَعْبُدُ","d":"aʿbudu","e":"I worship"}],"a":{"g":"Nor will you be worshippers of what I worship."}},"6":{"w":[{"c":"لَكُمْ","d":"lakum","e":"For you"},{"c":"دِينُكُمْ","d":"dīnukum","e":"(is) your religion"},{"c":"وَلِيَ","d":"waliya","e":"and for me"},{"c":"دِينِ","d":"dīni","e":"(is) my religion"}],"a":{"g":"For you is your religion, and for me is my religion.\""}}}