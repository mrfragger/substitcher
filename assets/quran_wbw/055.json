? -"}},"72":{"w":[{"c":"حُورٌ","d":"ḥūrun","e":"Fair ones"},{"c":"مَقْصُورَاتٌ","d":"maqṣūrātun","e":"restrained"},{"c":"فِي","d":"fī","e":"in"},{"c":"الْخِيَامِ","d":"l-khiyāmi","e":"the pavilions"}],"a":{"g":"Fair ones reserved in pavilions -"}},"73":{"w":[{"c":"فَبِأَيِّ","d":"fabi-ayyi","e":"So which"},{"c":"ءَالَاءِ","d":"ālāi","e":"(of the) favors"},{"c":"رَبِّكُمَا","d":"rabbikumā","e":"(of) your Lord"},{"c":"تُكَذِّبَانِ","d":"tukadhibāni","e":"will you both deny"}],"a":{"g":"So which of the favors of your Lord would you deny? -"}},"74":{"w":[{"c":"لَمْ","d":"lam","e":"Not"},{"c":"يَطْمِثْهُنَّ","d":"yaṭmith'hunna","e":"has touched them"},{"c":"إِنْسٌ","d":"insun","e":"any man"},{"c":"قَبْلَهُمْ","d":"qablahum","e":"before them"},{"c":"وَلَا","d":"walā","e":"and not"},{"c":"جَانٌّ","d":"jānnun","e":"any jinn"}],"a":{"g":"Untouched before them by man or jinni -"}},"75":{"w":[{"c":"فَبِأَيِّ","d":"fabi-ayyi","e":"So which"},{"c":"ءَالَاءِ","d":"ālāi","e":"(of the) favors"},{"c":"رَبِّكُمَا","d":"rabbikumā","e":"(of) your Lord"},{"c":"تُكَذِّبَانِ","d":"tukadhibāni","e":"will you both deny"}],"a":{"g":"So which of the favors of your Lord would you deny? -"}},"76":{"w":[{"c":"مُتَّكِئِينَ","d":"muttakiīna","e":"Reclining"},{"c":"عَلَى","d":"ʿalā","e":"on"},{"c":"رَفْرَفٍ","d":"rafrafin","e":"cushions"},{"c":"خُضْرٍ","d":"khuḍ'rin","e":"green"},{"c":"وَعَبْقَرِيٍّ","d":"waʿabqariyyin","e":"and carpets"},{"c":"حِسَانٍ","d":"ḥisānin","e":"beautiful"}],"a":{"g":"Reclining on green cushions and beautiful fine carpets."}},"77":{"w":[{"c":"فَبِأَيِّ","d":"fabi-ayyi","e":"So which"},{"c":"ءَالَاءِ","d":"ālāi","e":"(of the) favors"},{"c":"رَبِّكُمَا","d":"rabbikumā","e":"(of) your Lord"},{"c":"تُكَذِّبَانِ","d":"tukadhibāni","e":"will you both deny"}],"a":{"g":"So which of the favors of your Lord would you deny?"}},"78":{"w":[{"c":"تَبَارَكَ","d":"tabāraka","e":"Blessed is"},{"c":"اسْمُ","d":"us'mu","e":"(the) name"},{"c":"رَبِّكَ","d":"rabbika","e":"(of) your Lord"},{"c