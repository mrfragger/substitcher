{"1":{"w":[{"c":"الرَّحْمَنُ","d":"al-raḥmānu","e":"The Most Gracious"}],"a":{"g":"The Most Merciful"}},"2":{"w":[{"c":"عَلَّمَ","d":"ʿallama","e":"He taught"},{"c":"الْقُرْءَانَ","d":"l-qur'āna","e":"the Quran"}],"a":{"g":"Taught the Qur'an,"}},"3":{"w":[{"c":"خَلَقَ","d":"khalaqa","e":"He created"},{"c":"الْإِنْسَانَ","d":"l-insāna","e":"[the] man"}],"a":{"g":"Created man,"}},"4":{"w":[{"c":"عَلَّمَهُ","d":"ʿallamahu","e":"He taught him"},{"c":"الْبَيَانَ","d":"l-bayāna","e":"[the] speech"}],"a":{"g":"[And] taught him eloquence."}},"5":{"w":[{"c":"الشَّمْسُ","d":"al-shamsu","e":"The sun"},{"c":"وَالْقَمَرُ","d":"wal-qamaru","e":"and the moon"},{"c":"بِحُسْبَانٍ","d":"biḥus'bānin","e":"by (precise) calculation"}],"a":{"g":"The sun and the moon [move] by precise calculation,"}},"6":{"w":[{"c":"وَالنَّجْمُ","d":"wal-najmu","e":"And the stars"},{"c":"وَالشَّجَرُ","d":"wal-shajaru","e":"and the trees"},{"c":"يَسْجُدَانِ","d":"yasjudāni","e":"both prostrate"}],"a":{"g":"And the stars and trees prostrate."}},"7":{"w":[{"c":"وَالسَّمَاءَ","d":"wal-samāa","e":"And the heaven"},{"c":"رَفَعَهَا","d":"rafaʿahā","e":"He raised it"},{"c":"وَوَضَعَ","d":"wawaḍaʿa","e":"and He has set up"},{"c":"الْمِيزَانَ","d":"l-mīzāna","e":"the balance"}],"a":{"g":"And the heaven He raised and imposed the balance"}},"8":{"w":[{"c":"أَلَّا","d":"allā","e":"That not"},{"c":"تَطْغَوْا","d":"taṭghaw","e":"you may transgress"},{"c":"فِي","d":"fī","e":"in"},{"c":"الْمِيزَانِ","d":"l-mīzāni","e":"the balance"}],"a":{"g":"That you not transgress within the balance."}},"9":{"w":[{"c":"وَأَقِيمُوا","d":"wa-aqīmū","e":"And establish"},{"c":"الْوَزْنَ","d":"l-wazna","e":"the weight"},{"c":"بِالْقِسْطِ","d":"bil-qis'ṭi","e":"in justice"},{"c":"وَلَا","d":"walā","e":"and (do) not"},{"c":"تُخْسِرُوا","d":"tukh'sirū","e":"make deficient"},{"c":"الْمِيزَانَ","d":"l-mīzāna","e":"the balance"}],"a":{"g":"And establish weight in justice and do not make deficient the balance."}},"10":{"w":[{"c":"وَالْأَرْضَ","d":