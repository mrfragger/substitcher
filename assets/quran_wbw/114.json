{"1":{"w":[{"c":"قُلْ","d":"qul","e":"Say"},{"c":"أَعُوذُ","d":"aʿūdhu","e":"I seek refuge"},{"c":"بِرَبِّ","d":"birabbi","e":"in (the) Lord"},{"c":"النَّاسِ","d":"l-nāsi","e":"(of) mankind"}],"a":{"g":"Say, \"I seek refuge in the Lord of mankind,"}},"2":{"w":[{"c":"مَلِكِ","d":"maliki","e":"(The) King"},{"c":"النَّاسِ","d":"l-nāsi","e":"(of) mankind"}],"a":{"g":"The Sovereign of mankind."}},"3":{"w":[{"c":"إِلَهِ","d":"ilāhi","e":"(The) God"},{"c":"النَّاسِ","d":"l-nāsi","e":"(of) mankind"}],"a":{"g":"The God of mankind,"}},"4":{"w":[{"c":"مِنْ","d":"min","e":"From"},{"c":"شَرِّ","d":"sharri","e":"(the) evil"},{"c":"الْوَسْوَاسِ","d":"l-waswāsi","e":"(of) the whisperer"},{"c":"الْخَنَّاسِ","d":"l-khanāsi","e":"the one who withdraws"}],"a":{"g":"From the evil of the retreating whisperer -"}},"5":{"w":[{"c":"الَّذِي","d":"alladhī","e":"The one who"},{"c":"يُوَسْوِسُ","d":"yuwaswisu","e":"whispers"},{"c":"فِي","d":"fī","e":"in"},{"c":"صُدُورِ","d":"ṣudūri","e":"(the) breasts"},{"c":"النَّاسِ","d":"l-nāsi","e":"(of) mankind"}],"a":{"g":"Who whispers [evil] into the breasts of mankind -"}},"6":{"w":[{"c":"مِنَ","d":"mina","e":"From"},{"c":"الْجِنَّةِ","d":"l-jinati","e":"the jinn"},{"c":"وَالنَّاسِ","d":"wal-nāsi","e":"and men"}],"a":{"g":"From among the jinn and mankind.\""}}}