{"1":{"w":[{"c":"اقْرَأْ","d":"iq'ra","e":"Read"},{"c":"بِاسْمِ","d":"bi-is'mi","e":"in (the) name"},{"c":"رَبِّكَ","d":"rabbika","e":"(of) your Lord"},{"c":"الَّذِي","d":"alladhī","e":"the One Who"},{"c":"خَلَقَ","d":"khalaqa","e":"created"}],"a":{"g":"Recite in the name of your Lord who created -"}},"2":{"w":[{"c":"خَلَقَ","d":"khalaqa","e":"He created"},{"c":"الْإِنْسَانَ","d":"l-insāna","e":"man"},{"c":"مِنْ","d":"min","e":"from"},{"c":"عَلَقٍ","d":"ʿalaqin","e":"a clinging substance"}],"a":{"g":"Created man from a clinging substance."}},"3":{"w":[{"c":"اقْرَأْ","d":"iq'ra","e":"Read"},{"c":"وَرَبُّكَ","d":"warabbuka","e":"and your Lord"},{"c":"الْأَكْرَمُ","d":"l-akramu","e":"(is) the Most Generous"}],"a":{"g":"Recite, and your Lord is the most Generous -"}},"4":{"w":[{"c":"الَّذِي","d":"alladhī","e":"The One Who"},{"c":"عَلَّمَ","d":"ʿallama","e":"taught"},{"c":"بِالْقَلَمِ","d":"bil-qalami","e":"by the pen"}],"a":{"g":"Who taught by the pen -"}},"5":{"w":[{"c":"عَلَّمَ","d":"ʿallama","e":"Taught"},{"c":"الْإِنْسَانَ","d":"l-insāna","e":"man"},{"c":"مَا","d":"mā","e":"what"},{"c":"لَمْ","d":"lam","e":"not"},{"c":"يَعْلَمْ","d":"yaʿlam","e":"he knew"}],"a":{"g":"Taught man that which he knew not."}},"6":{"w":[{"c":"كَلَّا","d":"kallā","e":"Nay!"},{"c":"إِنَّ","d":"inna","e":"Indeed"},{"c":"الْإِنْسَانَ","d":"l-insāna","e":"man"},{"c":"لَيَطْغَى","d":"layaṭghā","e":"surely transgresses"}],"a":{"g":"No! [But] indeed, man transgresses"}},"7":{"w":[{"c":"أَنْ","d":"an","e":"Because"},{"c":"رَءَاهُ","d":"raāhu","e":"he sees himself"},{"c":"اسْتَغْنَى","d":"is'taghnā","e":"self-sufficient"}],"a":{"g":"Because he sees himself self-sufficient."}},"8":{"w":[{"c":"إِنَّ","d":"inna","e":"Indeed"},{"c":"إِلَى","d":"ilā","e":"to"},{"c":"رَبِّكَ","d":"rabbika","e":"your Lord"},{"c":"الرُّجْعَى","d":"l-ruj'ʿā","e":"(is) the return"}],"a":{"g":"Indeed, to your Lord is the return."}},"9":{"w":[{"c":"أَرَءَيْتَ","d":"ara-ayta","e":"Have you seen"},{"c":"الَّذِي","d":"alladhī","e":"the one who"},{"c":"يَنْهَى","d":"yanhā","e":"forbids"}],"a":{"g":"Have you seen the one who forbids"}},"10":{"w":[{"c":"عَبْدًا","d":"ʿabdan","e":"A slave"},{"c":"إِذَا","d":"idhā","e":"when"},{"c":"صَلَّى","d":"ṣallā","e":"he prays"}],"a":{"g":"A servant when he prays?"}},"11":{"w":[{"c":"أَرَءَيْتَ","d":"ara-ayta","e":"Have you seen"},{"c":"إِنْ","d":"in","e":"if"},{"c":"كَانَ","d":"kāna","e":"he is"},{"c":"عَلَى","d":"ʿalā","e":"upon"},{"c":"الْهُدَى","d":"l-hudā","e":"[the] guidance"}],"a":{"g":"Have you seen if he is upon guidance"}},"12":{"w":[{"c":"أَوْ","d":"aw","e":"Or"},{"c":"أَمَرَ","d":"amara","e":"he enjoins"},{"c":"بِالتَّقْوَى","d":"bil-taqwā","e":"[of the] righteousness"}],"a":{"g":"Or enjoins righteousness?"}},"13":{"w":[{"c":"أَرَءَيْتَ","d":"ara-ayta","e":"Have you seen"},{"c":"إِنْ","d":"in","e":"if"},{"c":"كَذَّبَ","d":"kadhaba","e":"he denies"},{"c":"وَتَوَلَّى","d":"watawallā","e":"and turns away"}],"a":{"g":"Have you seen if he denies and turns away -"}},"14":{"w":[{"c":"أَلَمْ","d":"alam","e":"Does not"},{"c":"يَعْلَمْ","d":"yaʿlam","e":"he know"},{"c":"بِأَنَّ","d":"bi-anna","e":"that"},{"c":"اللَّهَ","d":"l-laha","e":"Allah"},{"c":"يَرَى","d":"yarā","e":"sees"}],"a":{"g":"Does he not know that Allah sees?"}},"15":{"w":[{"c":"كَلَّا","d":"kallā","e":"Nay!"},{"c":"لَئِنْ","d":"la-in","e":"If"},{"c":"لَمْ","d":"lam","e":"not"},{"c":"يَنْتَهِ","d":"yantahi","e":"he desists"},{"c":"لَنَسْفَعًا","d":"lanasfaʿan","e":"surely We will drag him"},{"c":"بِالنَّاصِيَةِ","d":"bil-nāṣiyati","e":"by the forelock"}],"a":{"g":"No! If he does not desist, We will surely drag him by the forelock -"}},"16":{"w":[{"c":"نَاصِيَةٍ","d":"nāṣiyatin","e":"A forelock"},{"c":"كَاذِبَةٍ","d":"kādhibatin","e":"lying"},{"c":"خَاطِئَةٍ","d":"khāṭi-atin","e":"sinful"}],"a":{"g":"A lying, sinning forelock."}},"17":{"w":[{"c":"فَلْيَدْعُ","d":"falyadʿu","e":"Then let him call"},{"c":"نَادِيَهُ","d":"nādiyahu","e":"his associates"}],"a":{"g":"Then let him call his associates;"}},"18":{"w":[{"c":"سَنَدْعُ","d":"sanadʿu","e":"We will call"},{"c":"الزَّبَانِيَةَ","d":"l-zabāniyata","e":"the Angels of Hell"}],"a":{"g":"We will call the angels of Hell."}},"19":{"w":[{"c":"كَلَّا","d":"kallā","e":"Nay!"},{"c":"لَا","d":"lā","e":"(Do) not"},{"c":"تُطِعْهُ","d":"tuṭiʿ'hu","e":"obey him"},{"c":"وَاسْجُدْ","d":"wa-us'jud","e":"But prostrate"},{"c":"وَاقْتَرِبْ","d":"wa-iq'tarib","e":"and draw near (to Allah)"}],"a":{"g":"No! Do not obey him. But prostrate and draw near [to Allah]."}}}