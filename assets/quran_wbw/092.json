{"1":{"w":[{"c":"وَاللَّيْلِ","d":"wa-al-layli","e":"By the night"},{"c":"إِذَا","d":"idhā","e":"when"},{"c":"يَغْشَى","d":"yaghshā","e":"it covers"}],"a":{"g":"By the night when it covers"}},"2":{"w":[{"c":"وَالنَّهَارِ","d":"wal-nahāri","e":"And the day"},{"c":"إِذَا","d":"idhā","e":"when"},{"c":"تَجَلَّى","d":"tajallā","e":"it shines in brightness"}],"a":{"g":"And [by] the day when it appears"}},"3":{"w":[{"c":"وَمَا","d":"wamā","e":"And He Who"},{"c":"خَلَقَ","d":"khalaqa","e":"created"},{"c":"الذَّكَرَ","d":"l-dhakara","e":"the male"},{"c":"وَالْأُنْثَى","d":"wal-unthā","e":"and the female"}],"a":{"g":"And [by] He who created the male and female,"}},"4":{"w":[{"c":"إِنَّ","d":"inna","e":"Indeed"},{"c":"سَعْيَكُمْ","d":"saʿyakum","e":"your efforts"},{"c":"لَشَتَّى","d":"lashattā","e":"(are) surely diverse"}],"a":{"g":"Indeed, your efforts are diverse."}},"5":{"w":[{"c":"فَأَمَّا","d":"fa-ammā","e":"Then as for"},{"c":"مَنْ","d":"man","e":"(him) who"},{"c":"أَعْطَى","d":"aʿṭā","e":"gives"},{"c":"وَاتَّقَى","d":"wa-ittaqā","e":"and fears"}],"a":{"g":"As for he who gives and fears Allah"}},"6":{"w":[{"c":"وَصَدَّقَ","d":"waṣaddaqa","e":"And believes"},{"c":"بِالْحُسْنَى","d":"bil-ḥus'nā","e":"in the best"}],"a":{"g":"And believes in the best [reward],"}},"7":{"w":[{"c":"فَسَنُيَسِّرُهُ","d":"fasanuyassiruhu","e":"Then We will ease him"},{"c":"لِلْيُسْرَى","d":"lil'yus'rā","e":"towards [the] ease"}],"a":{"g":"We will ease him toward ease."}},"8":{"w":[{"c":"وَأَمَّا","d":"wa-ammā","e":"But as for"},{"c":"مَنْ","d":"man","e":"(him) who"},{"c":"بَخِلَ","d":"bakhila","e":"withholds"},{"c":"وَاسْتَغْنَى","d":"wa-is'taghnā","e":"and considers himself free from need"}],"a":{"g":"But as for he who withholds and considers himself free of need"}},"9":{"w":[{"c":"وَكَذَّبَ","d":"wakadhaba","e":"And denies"},{"c":"بِالْحُسْنَى","d":"bil-ḥus'nā","e":"the best"}],"a":{"g":"And denies the best [reward],"}},"10":{"w":[{"c":"فَسَنُيَسِّرُهُ","d":"fasanuyassiruhu","e":"Then We will 