{"1":{"w":[{"c":"إِذَا","d":"idhā","e":"When"},{"c":"الشَّمْسُ","d":"l-shamsu","e":"the sun"},{"c":"كُوِّرَتْ","d":"kuwwirat","e":"is wrapped up"}],"a":{"g":"When the sun is wrapped up [in darkness]"}},"2":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"النُّجُومُ","d":"l-nujūmu","e":"the stars"},{"c":"انْكَدَرَتْ","d":"inkadarat","e":"fall losing their luster"}],"a":{"g":"And when the stars fall, dispersing,"}},"3":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"الْجِبَالُ","d":"l-jibālu","e":"the mountains"},{"c":"سُيِّرَتْ","d":"suyyirat","e":"are moved away"}],"a":{"g":"And when the mountains are removed"}},"4":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"الْعِشَارُ","d":"l-ʿishāru","e":"the full-term she-camels"},{"c":"عُطِّلَتْ","d":"ʿuṭṭilat","e":"(are) left untended;"}],"a":{"g":"And when full-term she-camels are neglected"}},"5":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"الْوُحُوشُ","d":"l-wuḥūshu","e":"the wild beasts"},{"c":"حُشِرَتْ","d":"ḥushirat","e":"are gathered"}],"a":{"g":"And when the wild beasts are gathered"}},"6":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"الْبِحَارُ","d":"l-biḥāru","e":"the seas"},{"c":"سُجِّرَتْ","d":"sujjirat","e":"are made to overflow"}],"a":{"g":"And when the seas are filled with flame"}},"7":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"النُّفُوسُ","d":"l-nufūsu","e":"the souls"},{"c":"زُوِّجَتْ","d":"zuwwijat","e":"are paired"}],"a":{"g":"And when the souls are paired"}},"8":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"الْمَوْءُودَةُ","d":"l-mawūdatu","e":"the female infant buried alive"},{"c":"سُئِلَتْ","d":"su-ilat","e":"is asked"}],"a":{"g":"And when the girl [who was] buried alive is asked"}},"9":{"w":[{"c":"بِأَيِّ","d":"bi-ayyi","e":"For what"},{"c":"ذَنْبٍ","d":"dhanbin","e":"sin"},{"c":"قُتِلَتْ","d":"qutilat","e":"she was killed"}],"a":{"g":"For what sin she was killed"}},"10":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"الصُّحُفُ","d":"l-ṣuḥufu","e":"the pages"},{"c":"نُشِرَتْ","d":"nushirat","e":"are laid open"}],"a":{"g":"And when the pages are made public"}},"11":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"السَّمَاءُ","d":"l-samāu","e":"the sky"},{"c":"كُشِطَتْ","d":"kushiṭat","e":"is stripped away"}],"a":{"g":"And when the sky is stripped away"}},"12":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"الْجَحِيمُ","d":"l-jaḥīmu","e":"the Hellfire"},{"c":"سُعِّرَتْ","d":"suʿʿirat","e":"is set ablaze"}],"a":{"g":"And when Hellfire is set ablaze"}},"13":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"الْجَنَّةُ","d":"l-janatu","e":"Paradise"},{"c":"أُزْلِفَتْ","d":"uz'lifat","e":"is brought near"}],"a":{"g":"And when Paradise is brought near,"}},"14":{"w":[{"c":"عَلِمَتْ","d":"ʿalimat","e":"Will know"},{"c":"نَفْسٌ","d":"nafsun","e":"a soul"},{"c":"مَا","d":"mā","e":"what"},{"c":"أَحْضَرَتْ","d":"aḥḍarat","e":"it has brought"}],"a":{"g":"A soul will [then] know what it has brought [with it]."}},"15":{"w":[{"c":"فَلَا","d":"falā","e":"But nay!"},{"c":"أُقْسِمُ","d":"uq'simu","e":"I swear"},{"c":"بِالْخُنَّسِ","d":"bil-khunasi","e":"by the retreating planets"}],"a":{"g":"So I swear by the retreating stars -"}},"16":{"w":[{"c":"الْجَوَارِ","d":"al-jawāri","e":"Those that run"},{"c":"الْكُنَّسِ","d":"l-kunasi","e":"(and) disappear"}],"a":{"g":"Those that run [their courses] and disappear -"}},"17":{"w":[{"c":"وَاللَّيْلِ","d":"wa-al-layli","e":"And the night"},{"c":"إِذَا","d":"idhā","e":"when"},{"c":"عَسْعَسَ","d":"ʿasʿasa","e":"it departs"}],"a":{"g":"And by the night as it closes in"}},"18":{"w":[{"c":"وَالصُّبْحِ","d":"wal-ṣub'ḥi","e":"And the dawn"},{"c":"إِذَا","d":"idhā","e":"when"},{"c":"تَنَفَّسَ","d":"tanaffasa","e":"it breathes"}],"a":{"g":"And by the dawn when it breathes"}},"19":{"w":[{"c":"إِنَّهُ","d":"innahu","e":"Indeed it"},{"c":"لَقَوْلُ","d":"laqawlu","e":"(is) surely a word"},{"c":"رَسُولٍ","d":"rasūlin","e":"(of) a Messenger"},{"c":"كَرِيمٍ","d":"karīmin","e":"noble"}],"a":{"g":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger"}},"20":{"w":[{"c":"ذِي","d":"dhī","e":"Possessor of"},{"c":"قُوَّةٍ","d":"quwwatin","e":"power"},{"c":"عِنْدَ","d":"ʿinda","e":"with"},{"c":"ذِي","d":"dhī","e":"(the) Owner of"},{"c":"الْعَرْشِ","d":"l-ʿarshi","e":"the Throne"},{"c":"مَكِينٍ","d":"makīnin","e":"secure"}],"a":{"g":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],"}},"21":{"w":[{"c":"مُطَاعٍ","d":"muṭāʿin","e":"One to be obeyed"},{"c":"ثَمَّ","d":"thamma","e":"and"},{"c":"أَمِينٍ","d":"amīnin","e":"trustworthy"}],"a":{"g":"Obeyed there [in the heavens] and trustworthy."}},"22":{"w":[{"c":"وَمَا","d":"wamā","e":"And not"},{"c":"صَاحِبُكُمْ","d":"ṣāḥibukum","e":"(is) your companion"},{"c":"بِمَجْنُونٍ","d":"bimajnūnin","e":"mad"}],"a":{"g":"And your companion is not [at all] mad."}},"23":{"w":[{"c":"وَلَقَدْ","d":"walaqad","e":"And certainly"},{"c":"رَءَاهُ","d":"raāhu","e":"he saw him"},{"c":"بِالْأُفُقِ","d":"bil-ufuqi","e":"in the horizon"},{"c":"الْمُبِينِ","d":"l-mubīni","e":"the clear"}],"a":{"g":"And he has already seen Gabriel in the clear horizon."}},"24":{"w":[{"c":"وَمَا","d":"wamā","e":"And not"},{"c":"هُوَ","d":"huwa","e":"he (is)"},{"c":"عَلَى","d":"ʿalā","e":"on"},{"c":"الْغَيْبِ","d":"l-ghaybi","e":"the unseen"},{"c":"بِضَنِينٍ","d":"biḍanīnin","e":"a withholder"}],"a":{"g":"And Muhammad is not a withholder of [knowledge of] the unseen."}},"25":{"w":[{"c":"وَمَا","d":"wamā","e":"And not"},{"c":"هُوَ","d":"huwa","e":"it"},{"c":"بِقَوْلِ","d":"biqawli","e":"(is the) word"},{"c":"شَيْطَانٍ","d":"shayṭānin","e":"(of) Shaitaan"},{"c":"رَجِيمٍ","d":"rajīmin","e":"accursed"}],"a":{"g":"And the Qur'an is not the word of a devil, expelled [from the heavens]."}},"26":{"w":[{"c":"فَأَيْنَ","d":"fa-ayna","e":"So where"},{"c":"تَذْهَبُونَ","d":"tadhhabūna","e":"are you going"}],"a":{"g":"So where are you going?"}},"27":{"w":[{"c":"إِنْ","d":"in","e":"Not"},{"c":"هُوَ","d":"huwa","e":"it"},{"c":"إِلَّا","d":"illā","e":"(is) except"},{"c":"ذِكْرٌ","d":"dhik'run","e":"a reminder"},{"c":"لِلْعَالَمِينَ","d":"lil'ʿālamīna","e":"to the worlds"}],"a":{"g":"It is not except a reminder to the worlds"}},"28":{"w":[{"c":"لِمَنْ","d":"liman","e":"For whoever"},{"c":"شَاءَ","d":"shāa","e":"wills"},{"c":"مِنْكُمْ","d":"minkum","e":"among you"},{"c":"أَنْ","d":"an","e":"to"},{"c":"يَسْتَقِيمَ","d":"yastaqīma","e":"take a straight way"}],"a":{"g":"For whoever wills among you to take a right course."}},"29":{"w":[{"c":"وَمَا","d":"wamā","e":"And not"},{"c":"تَشَاءُونَ","d":"tashāūna","e":"you will"},{"c":"إِلَّا","d":"illā","e":"except"},{"c":"أَنْ","d":"an","e":"that"},{"c":"يَشَاءَ","d":"yashāa","e":"wills"},{"c":"اللَّهُ","d":"l-lahu","e":"Allah"},{"c":"رَبُّ","d":"rabbu","e":"Lord"},{"c":"الْعَالَمِينَ","d":"l-ʿālamīna","e":"(of) the worlds"}],"a":{"g":"And you do not will except that Allah wills - Lord of the worlds."}}}