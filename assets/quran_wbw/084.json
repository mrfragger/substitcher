{"1":{"w":[{"c":"إِذَا","d":"idhā","e":"When"},{"c":"السَّمَاءُ","d":"l-samāu","e":"the sky"},{"c":"انْشَقَّتْ","d":"inshaqqat","e":"is split asunder"}],"a":{"g":"When the sky has split [open]"}},"2":{"w":[{"c":"وَأَذِنَتْ","d":"wa-adhinat","e":"And has listened"},{"c":"لِرَبِّهَا","d":"lirabbihā","e":"to its Lord"},{"c":"وَحُقَّتْ","d":"waḥuqqat","e":"and was obligated"}],"a":{"g":"And has responded to its Lord and was obligated [to do so]"}},"3":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"الْأَرْضُ","d":"l-arḍu","e":"the earth"},{"c":"مُدَّتْ","d":"muddat","e":"is spread"}],"a":{"g":"And when the earth has been extended"}},"4":{"w":[{"c":"وَأَلْقَتْ","d":"wa-alqat","e":"And has cast out"},{"c":"مَا","d":"mā","e":"what"},{"c":"فِيهَا","d":"fīhā","e":"(is) in it"},{"c":"وَتَخَلَّتْ","d":"watakhallat","e":"and becomes empty"}],"a":{"g":"And has cast out that within it and relinquished [it]"}},"5":{"w":[{"c":"وَأَذِنَتْ","d":"wa-adhinat","e":"And has listened"},{"c":"لِرَبِّهَا","d":"lirabbihā","e":"to its Lord"},{"c":"وَحُقَّتْ","d":"waḥuqqat","e":"and was obligated"}],"a":{"g":"And has responded to its Lord and was obligated [to do so] -"}},"6":{"w":[{"c":"يَاأَيُّهَا","d":"yāayyuhā","e":"O"},{"c":"الْإِنْسَانُ","d":"l-insānu","e":"mankind"},{"c":"إِنَّكَ","d":"innaka","e":"Indeed, you"},{"c":"كَادِحٌ","d":"kādiḥun","e":"(are) laboring"},{"c":"إِلَى","d":"ilā","e":"to"},{"c":"رَبِّكَ","d":"rabbika","e":"your Lord"},{"c":"كَدْحًا","d":"kadḥan","e":"(with) exertion"},{"c":"فَمُلَاقِيهِ","d":"famulāqīhi","e":"and you (will) meet Him"}],"a":{"g":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it."}},"7":{"w":[{"c":"فَأَمَّا","d":"fa-ammā","e":"Then as for"},{"c":"مَنْ","d":"man","e":"(him) who"},{"c":"أُوتِيَ","d":"ūtiya","e":"is given"},{"c":"كِتَابَهُ","d":"kitābahu","e":"his record"},{"c":"بِيَمِينِهِ","d":"biyamīnihi","e":"in his right hand"}],"a":{"g":"Then as for he who is given his record in his right hand,"}},"8":{"w":[{"c":"فَسَوْفَ","d":"fasawfa","e":"Soon"},{"c":"يُحَاسَبُ","d":"yuḥāsabu","e":"his account will be taken"},{"c":"حِسَابًا","d":"ḥisāban","e":"an account"},{"c":"يَسِيرًا","d":"yasīran","e":"easy"}],"a":{"g":"He will be judged with an easy account"}},"9":{"w":[{"c":"وَيَنْقَلِبُ","d":"wayanqalibu","e":"And he will return"},{"c":"إِلَى","d":"ilā","e":"to"},{"c":"أَهْلِهِ","d":"ahlihi","e":"his people"},{"c":"مَسْرُورًا","d":"masrūran","e":"happily"}],"a":{"g":"And return to his people in happiness."}},"10":{"w":[{"c":"وَأَمَّا","d":"wa-ammā","e":"But as for"},{"c":"مَنْ","d":"man","e":"(him) who"},{"c":"أُوتِيَ","d":"ūtiya","e":"is given"},{"c":"كِتَابَهُ","d":"kitābahu","e":"his record"},{"c":"وَرَاءَ","d":"warāa","e":"behind"},{"c":"ظَهْرِهِ","d":"ẓahrihi","e":"his back"}],"a":{"g":"But as for he who is given his record behind his back,"}},"11":{"w":[{"c":"فَسَوْفَ","d":"fasawfa","e":"Soon"},{"c":"يَدْعُوا","d":"yadʿū","e":"he will call"},{"c":"ثُبُورًا","d":"thubūran","e":"(for) destruction"}],"a":{"g":"He will cry out for destruction"}},"12":{"w":[{"c":"وَيَصْلَى","d":"wayaṣlā","e":"And he will burn"},{"c":"سَعِيرًا","d":"saʿīran","e":"(in) a Blaze"}],"a":{"g":"And [enter to] burn in a Blaze."}},"13":{"w":[{"c":"إِنَّهُ","d":"innahu","e":"Indeed he"},{"c":"كَانَ","d":"kāna","e":"had been"},{"c":"فِي","d":"fī","e":"among"},{"c":"أَهْلِهِ","d":"ahlihi","e":"his people"},{"c":"مَسْرُورًا","d":"masrūran","e":"happy"}],"a":{"g":"Indeed, he had [once] been among his people in happiness;"}},"14":{"w":[{"c":"إِنَّهُ","d":"innahu","e":"Indeed he"},{"c":"ظَنَّ","d":"ẓanna","e":"(had) thought"},{"c":"أَنْ","d":"an","e":"that"},{"c":"لَنْ","d":"lan","e":"never"},{"c":"يَحُورَ","d":"yaḥūra","e":"he would return"}],"a":{"g":"Indeed, he had thought he would never return [to Allah]."}},"15":{"w":[{"c":"بَلَى","d":"balā","e":"Nay!"},{"c":"إِنَّ","d":"inna","e":"Indeed"},{"c":"رَبَّهُ","d":"rabbahu","e":"his Lord"},{"c":"كَانَ","d":"kāna","e":"was"},{"c":"بِهِ","d":"bihi","e":"of him"},{"c":"بَصِيرًا","d":"baṣīran","e":"seeing"}],"a":{"g":"But yes! Indeed, his Lord was ever of him, Seeing."}},"16":{"w":[{"c":"فَلَا","d":"falā","e":"But nay!"},{"c":"أُقْسِمُ","d":"uq'simu","e":"I swear"},{"c":"بِالشَّفَقِ","d":"bil-shafaqi","e":"by the twilight glow"}],"a":{"g":"So I swear by the twilight glow"}},"17":{"w":[{"c":"وَاللَّيْلِ","d":"wa-al-layli","e":"And the night"},{"c":"وَمَا","d":"wamā","e":"and what"},{"c":"وَسَقَ","d":"wasaqa","e":"it envelops"}],"a":{"g":"And [by] the night and what it envelops"}},"18":{"w":[{"c":"وَالْقَمَرِ","d":"wal-qamari","e":"And the moon"},{"c":"إِذَا","d":"idhā","e":"when"},{"c":"اتَّسَقَ","d":"ittasaqa","e":"it becomes full"}],"a":{"g":"And [by] the moon when it becomes full"}},"19":{"w":[{"c":"لَتَرْكَبُنَّ","d":"latarkabunna","e":"You will surely embark"},{"c":"طَبَقًا","d":"ṭabaqan","e":"(to) stage"},{"c":"عَنْ","d":"ʿan","e":"from"},{"c":"طَبَقٍ","d":"ṭabaqin","e":"stage"}],"a":{"g":"[That] you will surely experience state after state."}},"20":{"w":[{"c":"فَمَا","d":"famā","e":"So what"},{"c":"لَهُمْ","d":"lahum","e":"(is) for them"},{"c":"لَا","d":"lā","e":"not"},{"c":"يُؤْمِنُونَ","d":"yu'minūna","e":"they believe"}],"a":{"g":"So what is [the matter] with them [that] they do not believe,"}},"21":{"w":[{"c":"وَإِذَا","d":"wa-idhā","e":"And when"},{"c":"قُرِئَ","d":"quri-a","e":"is recited"},{"c":"عَلَيْهِمُ","d":"ʿalayhimu","e":"to them"},{"c":"الْقُرْءَانُ","d":"l-qur'ānu","e":"the Quran"},{"c":"لَا","d":"lā","e":"not"},{"c":"يَسْجُدُونَ","d":"yasjudūna","e":"they prostrate"}],"a":{"g":"And when the Qur'an is recited to them, they do not prostrate [to Allah]?"}},"22":{"w":[{"c":"بَلِ","d":"bali","e":"Nay!"},{"c":"الَّذِينَ","d":"alladhīna","e":"Those who"},{"c":"كَفَرُوا","d":"kafarū","e":"disbelieved"},{"c":"يُكَذِّبُونَ","d":"yukadhibūna","e":"deny"}],"a":{"g":"But those who have disbelieved deny,"}},"23":{"w":[{"c":"وَاللَّهُ","d":"wal-lahu","e":"And Allah"},{"c":"أَعْلَمُ","d":"aʿlamu","e":"(is) most knowing"},{"c":"بِمَا","d":"bimā","e":"of what"},{"c":"يُوعُونَ","d":"yūʿūna","e":"they keep within themselves"}],"a":{"g":"And Allah is most knowing of what they keep within themselves."}},"24":{"w":[{"c":"فَبَشِّرْهُمْ","d":"fabashir'hum","e":"So give them tidings"},{"c":"بِعَذَابٍ","d":"biʿadhābin","e":"of a punishment"},{"c":"أَلِيمٍ","d":"alīmin","e":"painful"}],"a":{"g":"So give them tidings of a painful punishment,"}},"25":{"w":[{"c":"إِلَّا","d":"illā","e":"Except"},{"c":"الَّذِينَ","d":"alladhīna","e":"those who"},{"c":"ءَامَنُوا","d":"āmanū","e":"believe"},{"c":"وَعَمِلُوا","d":"waʿamilū","e":"and do"},{"c":"الصَّالِحَاتِ","d":"l-ṣāliḥāti","e":"righteous deeds"},{"c":"لَهُمْ","d":"lahum","e":"For them"},{"c":"أَجْرٌ","d":"ajrun","e":"(is) a reward"},{"c":"غَيْرُ","d":"ghayru","e":"never"},{"c":"مَمْنُونٍ","d":"mamnūnin","e":"ending"}],"a":{"g":"Except for those who believe and do righteous deeds. For them is a reward uninterrupted."}}}