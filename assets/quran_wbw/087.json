{"1":{"w":[{"c":"سَبِّحِ","d":"sabbiḥi","e":"Glorify"},{"c":"اسْمَ","d":"is'ma","e":"(the) name"},{"c":"رَبِّكَ","d":"rabbika","e":"(of) your Lord"},{"c":"الْأَعْلَى","d":"l-aʿlā","e":"the Most High"}],"a":{"g":"Exalt the name of your Lord, the Most High,"}},"2":{"w":[{"c":"الَّذِي","d":"alladhī","e":"The One Who"},{"c":"خَلَقَ","d":"khalaqa","e":"created"},{"c":"فَسَوَّى","d":"fasawwā","e":"then proportioned"}],"a":{"g":"Who created and proportioned"}},"3":{"w":[{"c":"وَالَّذِي","d":"wa-alladhī","e":"And the One Who"},{"c":"قَدَّرَ","d":"qaddara","e":"measured"},{"c":"فَهَدَى","d":"fahadā","e":"then guided"}],"a":{"g":"And who destined and [then] guided"}},"4":{"w":[{"c":"وَالَّذِي","d":"wa-alladhī","e":"And the One Who"},{"c":"أَخْرَجَ","d":"akhraja","e":"brings forth"},{"c":"الْمَرْعَى","d":"l-marʿā","e":"the pasture"}],"a":{"g":"And who brings out the pasture"}},"5":{"w":[{"c":"فَجَعَلَهُ","d":"fajaʿalahu","e":"And then made it"},{"c":"غُثَاءً","d":"ghuthāan","e":"stubble"},{"c":"أَحْوَى","d":"aḥwā","e":"dark"}],"a":{"g":"And [then] makes it black stubble."}},"6":{"w":[{"c":"سَنُقْرِئُكَ","d":"sanuq'ri-uka","e":"We will make you recite"},{"c":"فَلَا","d":"falā","e":"so not"},{"c":"تَنْسَى","d":"tansā","e":"you will forget"}],"a":{"g":"We will make you recite, [O Muhammad], and you will not forget,"}},"7":{"w":[{"c":"إِلَّا","d":"illā","e":"Except"},{"c":"مَا","d":"mā","e":"what"},{"c":"شَاءَ","d":"shāa","e":"wills"},{"c":"اللَّهُ","d":"l-lahu","e":"Allah"},{"c":"إِنَّهُ","d":"innahu","e":"Indeed, He"},{"c":"يَعْلَمُ","d":"yaʿlamu","e":"knows"},{"c":"الْجَهْرَ","d":"l-jahra","e":"the manifest"},{"c":"وَمَا","d":"wamā","e":"and what"},{"c":"يَخْفَى","d":"yakhfā","e":"is hidden"}],"a":{"g":"Except what Allah should will. Indeed, He knows what is declared and what is hidden."}},"8":{"w":[{"c":"وَنُيَسِّرُكَ","d":"wanuyassiruka","e":"And We will ease you"},{"c":"لِلْيُسْرَى","d":"lil'yus'rā","e":"to the ease"}],"a":{"g":"And We will ease you toward ease."}},"9":{"w":[{"c":"فَذَكِّرْ","d":"fadhakkir","e":"So remind"},{"c":"إِنْ","d":"in","e":"if"},{"c":"نَفَعَتِ","d":"nafaʿati","e":"benefits"},{"c":"الذِّكْرَى","d":"l-dhik'rā","e":"the reminder"}],"a":{"g":"So remind, if the reminder should benefit;"}},"10":{"w":[{"c":"سَيَذَّكَّرُ","d":"sayadhakkaru","e":"He will pay heed"},{"c":"مَنْ","d":"man","e":"(one) who"},{"c":"يَخْشَى","d":"yakhshā","e":"fears (Allah)"}],"a":{"g":"He who fears [Allah] will be reminded."}},"11":{"w":[{"c":"وَيَتَجَنَّبُهَا","d":"wayatajannabuhā","e":"And will avoid it"},{"c":"الْأَشْقَى","d":"l-ashqā","e":"the wretched one"}],"a":{"g":"But the wretched one will avoid it -"}},"12":{"w":[{"c":"الَّذِي","d":"alladhī","e":"The one who"},{"c":"يَصْلَى","d":"yaṣlā","e":"will burn"},{"c":"النَّارَ","d":"l-nāra","e":"(in) the Fire"},{"c":"الْكُبْرَى","d":"l-kub'rā","e":"[the] great"}],"a":{"g":"[He] who will [enter and] burn in the greatest Fire,"}},"13":{"w":[{"c":"ثُمَّ","d":"thumma","e":"Then"},{"c":"لَا","d":"lā","e":"not"},{"c":"يَمُوتُ","d":"yamūtu","e":"he will die"},{"c":"فِيهَا","d":"fīhā","e":"therein"},{"c":"وَلَا","d":"walā","e":"and not"},{"c":"يَحْيَى","d":"yaḥyā","e":"will live"}],"a":{"g":"Neither dying therein nor living."}},"14":{"w":[{"c":"قَدْ","d":"qad","e":"Certainly"},{"c":"أَفْلَحَ","d":"aflaḥa","e":"has succeeded"},{"c":"مَنْ","d":"man","e":"(one) who"},{"c":"تَزَكَّى","d":"tazakkā","e":"purifies (himself)"}],"a":{"g":"He has certainly succeeded who purifies himself"}},"15":{"w":[{"c":"وَذَكَرَ","d":"wadhakara","e":"And remembers"},{"c":"اسْمَ","d":"is'ma","e":"(the) name"},{"c":"رَبِّهِ","d":"rabbihi","e":"(of) his Lord"},{"c":"فَصَلَّى","d":"faṣallā","e":"and prays"}],"a":{"g":"And mentions the name of his Lord and prays."}},"16":{"w":[{"c":"بَلْ","d":"bal","e":"Nay!"},{"c":"تُؤْثِرُونَ","d":"tu'thirūna","e":"You prefer"},{"c":"الْحَيَوةَ","d":"l-ḥayata","e":"the life"},{"c":"الدُّنْيَا","d":"l-dun'yā","e":"(of) the world"}],"a":{"g":"But you prefer the worldly life,"}},"17":{"w":[{"c":"وَالْءَاخِرَةُ","d":"wal-ākhiratu","e":"While the Hereafter"},{"c":"خَيْرٌ","d":"khayrun","e":"(is) better"},{"c":"وَأَبْقَى","d":"wa-abqā","e":"and ever lasting"}],"a":{"g":"While the Hereafter is better and more enduring."}},"18":{"w":[{"c":"إِنَّ","d":"inna","e":"Indeed"},{"c":"هَذَا","d":"hādhā","e":"this"},{"c":"لَفِي","d":"lafī","e":"surely (is) in"},{"c":"الصُّحُفِ","d":"l-ṣuḥufi","e":"the Scriptures"},{"c":"الْأُولَى","d":"l-ūlā","e":"[the] former"}],"a":{"g":"Indeed, this is in the former scriptures,"}},"19":{"w":[{"c":"صُحُفِ","d":"ṣuḥufi","e":"(The) Scriptures"},{"c":"إِبْرَاهِيمَ","d":"ib'rāhīma","e":"(of) Ibrahim"},{"c":"وَمُوسَى","d":"wamūsā","e":"and Musa"}],"a":{"g":"The scriptures of Abraham and Moses."}}}