{"1":{"w":[{"c":"هَلْ","d":"hal","e":"Has"},{"c":"أَتَىكَ","d":"atāka","e":"(there) come to you"},{"c":"حَدِيثُ","d":"ḥadīthu","e":"(the) news"},{"c":"الْغَاشِيَةِ","d":"l-ghāshiyati","e":"(of) the Overwhelming"}],"a":{"g":"Has there reached you the report of the Overwhelming [event]?"}},"2":{"w":[{"c":"وُجُوهٌ","d":"wujūhun","e":"Faces"},{"c":"يَوْمَئِذٍ","d":"yawma-idhin","e":"that Day"},{"c":"خَاشِعَةٌ","d":"khāshiʿatun","e":"(will be) humbled"}],"a":{"g":"[Some] faces, that Day, will be humbled,"}},"3":{"w":[{"c":"عَامِلَةٌ","d":"ʿāmilatun","e":"Laboring"},{"c":"نَاصِبَةٌ","d":"nāṣibatun","e":"exhausted"}],"a":{"g":"Working [hard] and exhausted."}},"4":{"w":[{"c":"تَصْلَى","d":"taṣlā","e":"They will burn"},{"c":"نَارًا","d":"nāran","e":"(in) a Fire"},{"c":"حَامِيَةً","d":"ḥāmiyatan","e":"intensely hot"}],"a":{"g":"They will [enter to] burn in an intensely hot Fire."}},"5":{"w":[{"c":"تُسْقَى","d":"tus'qā","e":"They will be given to drink"},{"c":"مِنْ","d":"min","e":"from"},{"c":"عَيْنٍ","d":"ʿaynin","e":"a spring"},{"c":"ءَانِيَةٍ","d":"āniyatin","e":"boiling"}],"a":{"g":"They will be given drink from a boiling spring."}},"6":{"w":[{"c":"لَيْسَ","d":"laysa","e":"Is not"},{"c":"لَهُمْ","d":"lahum","e":"for them"},{"c":"طَعَامٌ","d":"ṭaʿāmun","e":"food"},{"c":"إِلَّا","d":"illā","e":"except"},{"c":"مِنْ","d":"min","e":"from"},{"c":"ضَرِيعٍ","d":"ḍarīʿin","e":"a bitter thorny plant"}],"a":{"g":"For them there will be no food except from a poisonous, thorny plant"}},"7":{"w":[{"c":"لَا","d":"lā","e":"Not"},{"c":"يُسْمِنُ","d":"yus'minu","e":"it nourishes"},{"c":"وَلَا","d":"walā","e":"and not"},{"c":"يُغْنِي","d":"yugh'nī","e":"it avails"},{"c":"مِنْ","d":"min","e":"against"},{"c":"جُوعٍ","d":"jūʿin","e":"hunger"}],"a":{"g":"Which neither nourishes nor avails against hunger."}},"8":{"w":[{"c":"وُجُوهٌ","d":"wujūhun","e":"Faces"},{"c":"يَوْمَئِذٍ","d":"yawma-idhin","e":"that Day"},{"c":"نَاعِمَةٌ","d":"nāʿimatun","e":"(will be) joyful"}],"a":{"g":"[Other] faces, that Day, will show pleasure."}},"9":{"w":[{"c":"لِسَعْيِهَا","d":"lisaʿyihā","e":"With their effort"},{"c":"رَاضِيَةٌ","d":"rāḍiyatun","e":"satisfied"}],"a":{"g":"With their effort [they are] satisfied"}},"10":{"w":[{"c":"فِي","d":"fī","e":"In"},{"c":"جَنَّةٍ","d":"jannatin","e":"a garden"},{"c":"عَالِيَةٍ","d":"ʿāliyatin","e":"elevated"}],"a":{"g":"In an elevated garden,"}},"11":{"w":[{"c":"لَا","d":"lā","e":"Not"},{"c":"تَسْمَعُ","d":"tasmaʿu","e":"they will hear"},{"c":"فِيهَا","d":"fīhā","e":"therein"},{"c":"لَاغِيَةً","d":"lāghiyatan","e":"vain talk"}],"a":{"g":"Wherein they will hear no unsuitable speech."}},"12":{"w":[{"c":"فِيهَا","d":"fīhā","e":"Therein"},{"c":"عَيْنٌ","d":"ʿaynun","e":"(will be) a spring"},{"c":"جَارِيَةٌ","d":"jāriyatun","e":"flowing"}],"a":{"g":"Within it is a flowing spring."}},"13":{"w":[{"c":"فِيهَا","d":"fīhā","e":"Therein"},{"c":"سُرُرٌ","d":"sururun","e":"(will be) thrones"},{"c":"مَرْفُوعَةٌ","d":"marfūʿatun","e":"raised high"}],"a":{"g":"Within it are couches raised high"}},"14":{"w":[{"c":"وَأَكْوَابٌ","d":"wa-akwābun","e":"And cups"},{"c":"مَوْضُوعَةٌ","d":"mawḍūʿatun","e":"put in place"}],"a":{"g":"And cups put in place"}},"15":{"w":[{"c":"وَنَمَارِقُ","d":"wanamāriqu","e":"And cushions"},{"c":"مَصْفُوفَةٌ","d":"maṣfūfatun","e":"lined up"}],"a":{"g":"And cushions lined up"}},"16":{"w":[{"c":"وَزَرَابِيُّ","d":"wazarābiyyu","e":"And carpets"},{"c":"مَبْثُوثَةٌ","d":"mabthūthatun","e":"spread out"}],"a":{"g":"And carpets spread around."}},"17":{"w":[{"c":"أَفَلَا","d":"afalā","e":"Then do not"},{"c":"يَنْظُرُونَ","d":"yanẓurūna","e":"they look"},{"c":"إِلَى","d":"ilā","e":"at"},{"c":"الْإِبِلِ","d":"l-ibili","e":"the camels"},{"c":"كَيْفَ","d":"kayfa","e":"how"},{"c":"خُلِقَتْ","d":"khuliqat","e":"they are created"}],"a":{"g":"Then do they not look at the camels - how they are created?"}},"18":{"w":[{"c":"وَإِلَى","d":"wa-ilā","e":"And at"},{"c":"السَّمَاءِ","d":"l-samāi","e":"the sky"},{"c":"كَيْفَ","d":"kayfa","e":"how"},{"c":"رُفِعَتْ","d":"rufiʿat","e":"it is raised"}],"a":{"g":"And at the sky - how it is raised?"}},"19":{"w":[{"c":"وَإِلَى","d":"wa-ilā","e":"And at"},{"c":"الْجِبَالِ","d":"l-jibāli","e":"the mountains"},{"c":"كَيْفَ","d":"kayfa","e":"how"},{"c":"نُصِبَتْ","d":"nuṣibat","e":"they are fixed"}],"a":{"g":"And at the mountains - how they are erected?"}},"20":{"w":[{"c":"وَإِلَى","d":"wa-ilā","e":"And at"},{"c":"الْأَرْضِ","d":"l-arḍi","e":"the earth"},{"c":"كَيْفَ","d":"kayfa","e":"how"},{"c":"سُطِحَتْ","d":"suṭiḥat","e":"it is spread out"}],"a":{"g":"And at the earth - how it is spread out?"}},"21":{"w":[{"c":"فَذَكِّرْ","d":"fadhakkir","e":"So remind"},{"c":"إِنَّمَا","d":"innamā","e":"only"},{"c":"أَنْتَ","d":"anta","e":"you"},{"c":"مُذَكِّرٌ","d":"mudhakkirun","e":"(are) a reminder"}],"a":{"g":"So remind, [O Muhammad]; you are only a reminder."}},"22":{"w":[{"c":"لَسْتَ","d":"lasta","e":"You are not"},{"c":"عَلَيْهِمْ","d":"ʿalayhim","e":"over them"},{"c":"بِمُصَيْطِرٍ","d":"bimuṣayṭirin","e":"a controller"}],"a":{"g":"You are not over them a controller."}},"23":{"w":[{"c":"إِلَّا","d":"illā","e":"But"},{"c":"مَنْ","d":"man","e":"whoever"},{"c":"تَوَلَّى","d":"tawallā","e":"turns away"},{"c":"وَكَفَرَ","d":"wakafara","e":"and disbelieves"}],"a":{"g":"However, he who turns away and disbelieves -"}},"24":{"w":[{"c":"فَيُعَذِّبُهُ","d":"fayuʿadhibuhu","e":"Then will punish him"},{"c":"اللَّهُ","d":"l-lahu","e":"Allah"},{"c":"الْعَذَابَ","d":"l-ʿadhāba","e":"(with) the punishment"},{"c":"الْأَكْبَرَ","d":"l-akbara","e":"greatest"}],"a":{"g":"Then Allah will punish him with the greatest punishment."}},"25":{"w":[{"c":"إِنَّ","d":"inna","e":"Indeed"},{"c":"إِلَيْنَا","d":"ilaynā","e":"to Us"},{"c":"إِيَابَهُمْ","d":"iyābahum","e":"(will be) their return"}],"a":{"g":"Indeed, to Us is their return."}},"26":{"w":[{"c":"ثُمَّ","d":"thumma","e":"Then"},{"c":"إِنَّ","d":"inna","e":"indeed"},{"c":"عَلَيْنَا","d":"ʿalaynā","e":"upon Us"},{"c":"حِسَابَهُمْ","d":"ḥisābahum","e":"(is) their account"}],"a":{"g":"Then indeed, upon Us is their account."}}}