{"1":{"w":[{"c":"أَلَمْ","d":"alam","e":"Have not"},{"c":"نَشْرَحْ","d":"nashraḥ","e":"We expanded"},{"c":"لَكَ","d":"laka","e":"for you"},{"c":"صَدْرَكَ","d":"ṣadraka","e":"your breast"}],"a":{"g":"Did We not expand for you, [O Muhammad], your breast?"}},"2":{"w":[{"c":"وَوَضَعْنَا","d":"wawaḍaʿnā","e":"And We removed"},{"c":"عَنْكَ","d":"ʿanka","e":"from you"},{"c":"وِزْرَكَ","d":"wiz'raka","e":"your burden"}],"a":{"g":"And We removed from you your burden"}},"3":{"w":[{"c":"الَّذِي","d":"alladhī","e":"Which"},{"c":"أَنْقَضَ","d":"anqaḍa","e":"weighed upon"},{"c":"ظَهْرَكَ","d":"ẓahraka","e":"your back"}],"a":{"g":"Which had weighed upon your back"}},"4":{"w":[{"c":"وَرَفَعْنَا","d":"warafaʿnā","e":"And We raised high"},{"c":"لَكَ","d":"laka","e":"for you"},{"c":"ذِكْرَكَ","d":"dhik'raka","e":"your esteem"}],"a":{"g":"And raised high for you your repute."}},"5":{"w":[{"c":"فَإِنَّ","d":"fa-inna","e":"So indeed"},{"c":"مَعَ","d":"maʿa","e":"with"},{"c":"الْعُسْرِ","d":"l-ʿus'ri","e":"the hardship"},{"c":"يُسْرًا","d":"yus'ran","e":"(is) ease"}],"a":{"g":"For indeed, with hardship [will be] ease."}},"6":{"w":[{"c":"إِنَّ","d":"inna","e":"Indeed"},{"c":"مَعَ","d":"maʿa","e":"with"},{"c":"الْعُسْرِ","d":"l-ʿus'ri","e":"the hardship"},{"c":"يُسْرًا","d":"yus'ran","e":"(is) ease"}],"a":{"g":"Indeed, with hardship [will be] ease."}},"7":{"w":[{"c":"فَإِذَا","d":"fa-idhā","e":"So when"},{"c":"فَرَغْتَ","d":"faraghta","e":"you are free"},{"c":"فَانْصَبْ","d":"fa-inṣab","e":"then stand up"}],"a":{"g":"So when you have finished [your duties], then stand up [for worship]."}},"8":{"w":[{"c":"وَإِلَى","d":"wa-ilā","e":"And to"},{"c":"رَبِّكَ","d":"rabbika","e":"your Lord"},{"c":"فَارْغَبْ","d":"fa-ir'ghab","e":"turn your attention"}],"a":{"g":"And to your Lord direct [your] longing."}}}