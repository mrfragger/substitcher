{"1":{"w":[{"c":"بِسْمِ","d":"bis'mi","e":"In (the) name"},{"c":"اللَّهِ","d":"l-lahi","e":"(of) Allah"},{"c":"الرَّحْمَنِ","d":"l-raḥmāni","e":"the Most Gracious"},{"c":"الرَّحِيمِ","d":"l-raḥīmi","e":"the Most Merciful"}],"a":{"g":"In the name of Allah, the Entirely Merciful, the Especially Merciful."}},"2":{"w":[{"c":"الْحَمْدُ","d":"al-ḥamdu","e":"All praises and thanks"},{"c":"لِلَّهِ","d":"lillahi","e":"(be) to Allah"},{"c":"رَبِّ","d":"rabbi","e":"(the) Lord"},{"c":"الْعَالَمِينَ","d":"l-ʿālamīna","e":"(of all) the worlds"}],"a":{"g":"[All] praise is [due] to Allah, Lord of the worlds -"}},"3":{"w":[{"c":"الرَّحْمَنِ","d":"al-raḥmāni","e":"The Most Gracious"},{"c":"الرَّحِيمِ","d":"l-raḥīmi","e":"the Most Merciful"}],"a":{"g":"The Entirely Merciful, the Especially Merciful,"}},"4":{"w":[{"c":"مَالِكِ","d":"māliki","e":"Master"},{"c":"يَوْمِ","d":"yawmi","e":"(of the) Day"},{"c":"الدِّينِ","d":"l-dīni","e":"(of) [the] Judgment"}],"a":{"g":"Sovereign of the Day of Recompense."}},"5":{"w":[{"c":"إِيَّاكَ","d":"iyyāka","e":"You Alone"},{"c":"نَعْبُدُ","d":"naʿbudu","e":"we worship"},{"c":"وَإِيَّاكَ","d":"wa-iyyāka","e":"and You Alone"},{"c":"نَسْتَعِينُ","d":"nastaʿīnu","e":"we ask for help"}],"a":{"g":"It is You we worship and You we ask for help."}},"6":{"w":[{"c":"اهْدِنَا","d":"ih'dinā","e":"Guide us"},{"c":"الصِّرَاطَ","d":"l-ṣirāṭa","e":"(to) the path"},{"c":"الْمُسْتَقِيمَ","d":"l-mus'taqīma","e":"the straight"}],"a":{"g":"Guide us to the straight path -"}},"7":{"w":[{"c":"صِرَاطَ","d":"ṣirāṭa","e":"(The) path"},{"c":"الَّذِينَ","d":"alladhīna","e":"(of) those"},{"c":"أَنْعَمْتَ","d":"anʿamta","e":"You have bestowed (Your) Favors"},{"c":"عَلَيْهِمْ","d":"ʿalayhim","e":"on them"},{"c":"غَيْرِ","d":"ghayri","e":"not (of)"},{"c":"الْمَغْضُوبِ","d":"l-maghḍūbi","e":"those who earned (Your) wrath"},{"c":"عَلَيْهِمْ","d":"ʿalayhim","e":"on themselves"},{"c":"وَلَا","d":"walā","e":"and not"},{"c":"الضَّالِّينَ","d":"l-ḍālīna","e":"(of) those who go astray"}],"a":{"g":"The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray."}}}