    "categories": [
      {
        "name": "أَنْوَاعُ الْبَشَرِ",
        "nameEn": "Human beings mentioned in the Qur'an",
        "color": "yellow",
        "items": [
          {
            "ar": "الْإِنسَانُ",
            "en": "[the] man",
            "ref": "36:77",
            "verse": "أَوَلَمْ يَرَ ٱلْإِنسَـٰنُ أَنَّا خَلَقْنَـٰهُ مِن نُّطْفَةٍۢ فَإِذَا هُوَ خَصِيمٌۭ مُّبِينٌۭ",
            "verseEn": "Does man not consider that We created him from a [mere] sperm-drop - then at once he is a clear adversary?"
          },
          {
            "ar": "لِلْعِبَادِ",
            "en": "for the slaves",
            "ref": "50:11",
            "verse": "رِّزْقًۭا لِّلْعِبَادِ ۖ وَأَحْيَيْنَا بِهِۦ بَلْدَةًۭ مَّيْتًۭا ۚ كَذَٰلِكَ ٱلْخُرُوجُ",
            "verseEn": "As provision for the servants, and We have given life thereby to a dead land. Thus is the emergence [i.e., resurrection]."
          },
          {
            "ar": "قَوْمٍ",
            "en": "a people",
            "ref": "5:102",
            "verse": "قَدْ سَأَلَهَا قَوْمٌۭ مِّن قَبْلِكُمْ ثُمَّ أَصْبَحُوا۟ بِهَا كَـٰفِرِينَ",
            "verseEn": "A people asked such [questions] before you; then they became thereby disbelievers."
          },
          {
            "ar": "الرِّجَالَ",
            "en": "the men",
            "ref": "29:29",
            "verse": "أَئِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ وَتَقْطَعُونَ ٱلسَّبِيلَ وَتَأْتُونَ فِى نَادِيكُمُ ٱلْمُنكَرَ ۖ فَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ أَن قَالُوا۟ ٱئْتِنَا بِعَذَابِ ٱللَّهِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ",
            "verseEn": "Indeed, you approach men and obstruct the road and commit in your meetings [every] evil.\" And the answer of his people was not but that they said, \"Bring us the punishment of Allāh, if you should be of the truthful.\""
          }
        ]
      },
      {
        "name": "أَنْوَاعُ الْكَلَامِ الْمَنْطُوقِ",
        "nameEn": "Types of spoken utterances mentioned in the Qur'an",
        "color": "green",
        "items": [
          {
            "ar": "الْقَوْلِ",
            "en": "[the] speech",
            "ref": "21:110",
            "verse": "إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ مِنَ ٱلْقَوْلِ وَيَعْلَمُ مَا تَكْتُمُونَ",
            "verseEn": "Indeed, He knows what is declared of speech, and He knows what you conceal."
          },
          {
            "ar": "الْحَدِيثِ",
            "en": "Statement",
            "ref": "68:44",
            "verse": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَـٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ",
            "verseEn": "So leave Me, [O Muḥammad], with [the matter of] whoever denies this statement [i.e., the Qur’ān]. We will progressively lead them [to punishment] from where they do not know."
          },
          {
            "ar": "الْوَعْدُ",
            "en": "promise (be fulfilled)",
            "ref": "27:71",
            "verse": "وَيَقُولُونَ مَتَىٰ هَـٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَـٰدِقِينَ",
            "verseEn": "And they say, \"When is [the fulfillment of] this promise, if you should be truthful?\""
          },
          {
            "ar": "أَيْمَانَهُمْ",
            "en": "their oaths",
            "ref": "58:16",
            "verse": "ٱتَّخَذُوٓا۟ أَيْمَـٰنَهُمْ جُنَّةًۭ فَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ فَلَهُمْ عَذَابٌۭ مُّهِينٌۭ",
            "verseEn": "They took their [false] oaths as a cover, so they averted [people] from the way of Allāh, and for them is a humiliating punishment."
          }
        ]
      },
      {
        "name": "عَطَايَا اللَّهِ وَجَزَاؤُهُ",
        "nameEn": "Gifts and rewards bestowed by Allah",
        "color": "blue",
        "items": [
          {
            "ar": "رَحْمَةً",
            "en": "As Mercy",
            "ref": "44:6",
            "verse": "رَحْمَةًۭ مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",
            "verseEn": "As mercy from your Lord. Indeed, He is the Hearing, the Knowing,"
          },
          {
            "ar": "نِعْمَةُ",
            "en": "(for the) Grace",
            "ref": "37:57",
            "verse": "وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ",
            "verseEn": "If not for the favor of my Lord, I would have been of those brought in [to Hell]."
          },
          {
            "ar": "ٱلرِّزْقَ",
            "en": "the provision",
            "ref": "39:52",
            "verse": "أَوَلَمْ يَعْلَمُوٓا۟ أَنَّ ٱللَّهَ يَبْسُطُ ٱلرِّزْقَ لِمَن يَشَآءُ وَيَقْدِرُ ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍۢ لِّقَوْمٍۢ يُؤْمِنُونَ",
            "verseEn": "Do they not know that Allāh extends provision for whom He wills and restricts [it]? Indeed in that are signs for a people who believe."
          },
          {
            "ar": "أَجْرَهُم",
            "en": "their reward",
            "ref": "28:54",
            "verse": "أُو۟لَـٰٓئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا۟ وَيَدْرَءُونَ بِٱلْحَسَنَةِ ٱلسَّيِّئَةَ وَمِمَّا رَزَقْنَـٰهُمْ يُنفِقُونَ",
            "verseEn": "Those will be given their reward twice for what they patiently endured and [because] they avert evil through good, and from what We have provided them they spend."
          }
        ]
      },
      {
        "name": "مُصْطَلَحَاتُ الْحَرْبِ وَالْقِتَالِ",
        "nameEn": "Warfare terms mentioned in the Qur'an",
        "color": "purple",
        "items": [
          {
            "ar": "ٱلْحَرْبِ",
            "en": "the war",
            "ref": "8:57",
            "verse": "فَإِمَّا تَثْقَفَنَّهُمْ فِى ٱلْحَرْبِ فَشَرِّدْ بِهِم مَّنْ خَلْفَهُمْ لَعَلَّهُمْ يَذَّكَّرُونَ",
            "verseEn": "So if you, [O Muḥammad], gain dominance over them in war, disperse by [means of] them those behind them that perhaps they will be reminded."
          },
          {
            "ar": "ٱلْجَمْعُ",
            "en": "(their) assembly",
            "ref": "54:45",
            "verse": "سَيُهْزَمُ ٱلْجَمْعُ وَيُوَلُّونَ ٱلدُّبُرَ",
            "verseEn": "[Their] assembly will be defeated, and they will turn their backs [in retreat]."
          },
          {
            "ar": "مَصَانِعَ",
            "en": "strongholds",
            "ref": "26:129",
            "verse": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ",
            "verseEn": "And take for yourselves constructions [i.e., palaces and fortresses] that you might abide eternally?"
          },
          {
            "ar": "حِجَارَةً",
            "en": "stones",
            "ref": "51:33",
            "verse": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةًۭ مِّن طِينٍۢ",
            "verseEn": "To send down upon them stones of clay,"
          }
        ]
      }
    ]
  },
