        "items": [
          {
            "ar": "قُرْءَانًا",
            "en": "A Quran",
            "ref": "39:28",
            "verse": "قُرْءَانًا عَرَبِيًّا غَيْرَ ذِى عِوَجٍۢ لَّعَلَّهُمْ يَتَّقُونَ",
            "verseEn": "[It is] an Arabic Qur’ān, without any deviance that they might become righteous."
          },
          {
            "ar": "بِالْكِتَابِ",
            "en": "the Book",
            "ref": "40:70",
            "verse": "ٱلَّذِينَ كَذَّبُوا۟ بِٱلْكِتَـٰبِ وَبِمَآ أَرْسَلْنَا بِهِۦ رُسُلَنَا ۖ فَسَوْفَ يَعْلَمُونَ",
            "verseEn": "Those who deny the Book [i.e., the Qur’ān] and that with which We sent Our messengers - they are going to know,"
          },
          {
            "ar": "لَآيَاتٍ",
            "en": "surely (are) Signs",
            "ref": "23:30",
            "verse": "إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍۢ وَإِن كُنَّا لَمُبْتَلِينَ",
            "verseEn": "Indeed in that are signs, and indeed, We are ever testing [Our servants]."
          },
          {
            "ar": "لَذِكْرٌ",
            "en": "(is) surely, a Reminder",
            "ref": "43:44",
            "verse": "وَإِنَّهُۥ لَذِكْرٌۭ لَّكَ وَلِقَوْمِكَ ۖ وَسَوْفَ تُسْـَٔلُونَ",
            "verseEn": "And indeed, it is a remembrance for you and your people, and you [all] are going to be questioned."
          }
        ]
      },
      {
        "name": "أَلْقَابُ رُسُلِ اللَّهِ",
        "nameEn": "Titles given to Allah's messengers",
        "color": "green",
        "items": [
          {
            "ar": "النَّبِيُّ",
            "en": "O Prophet",
            "ref": "9:73",
            "verse": "يَـٰٓأَيُّهَا ٱلنَّبِىُّ جَـٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ وَٱغْلُظْ عَلَيْهِمْ ۚ وَمَأْوَىٰهُمْ جَهَنَّمُ ۖ وَبِئْسَ ٱلْمَصِيرُ",
            "verseEn": "O Prophet, fight against the disbelievers and the hypocrites and be harsh upon them. And their refuge is Hell, and wretched is the destination."
          },
          {
            "ar": "الْمُرْسَلِينَ",
            "en": "the Messengers",
            "ref": "37:37",
            "verse": "بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ",
            "verseEn": "Rather, he [i.e., the Prophet (ﷺ)] has come with the truth and confirmed the [previous] messengers."
          },
          {
            "ar": "نَذِيرٍ",
            "en": "warner",
            "ref": "34:44",
            "verse": "وَمَآ ءَاتَيْنَـٰهُم مِّن كُتُبٍۢ يَدْرُسُونَهَا ۖ وَمَآ أَرْسَلْنَآ إِلَيْهِمْ قَبْلَكَ مِن نَّذِيرٍۢ",
            "verseEn": "And We had not given them any scriptures which they could study, and We had not sent to them before you, [O Muḥammad], any warner."
          },
          {
            "ar": "عَبْدَنَا",
            "en": "Our slave",
            "ref": "38:41",
            "verse": "وَٱذْكُرْ عَبْدَنَآ أَيُّوبَ إِذْ نَادَىٰ رَبَّهُۥٓ أَنِّى مَسَّنِىَ ٱلشَّيْطَـٰنُ بِنُصْبٍۢ وَعَذَابٍ",
            "verseEn": "And remember Our servant Job, when he called to his Lord, \"Indeed, Satan has touched me with hardship and torment.\""
          }
        ]
      },
      {
        "name": "مَعْبُودَاتٌ بَاطِلَةٌ مِنْ دُونِ اللَّهِ",
        "nameEn": "Beings falsely worshipped besides Allah",
        "color": "blue",
        "items": [
          {
            "ar": "وَالطَّاغُوتِ",
            "en": "and the false deities",
            "ref": "4:51",
            "verse": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ أُوتُوا۟ نَصِيبًۭا مِّنَ ٱلْكِتَـٰبِ يُؤْمِنُونَ بِٱلْجِبْتِ وَٱلطَّـٰغُوتِ وَيَقُولُونَ لِلَّذِينَ كَفَرُوا۟ هَـٰٓؤُلَآءِ أَهْدَىٰ مِنَ ٱلَّذِينَ ءَامَنُوا۟ سَبِيلًا",
            "verseEn": "Have you not seen those who were given a portion of the Scripture, who believe in jibt [superstition] and ṭāghūt [false objects of worship] and say about the disbelievers, \"These are better guided than the believers as to the way\"?"
          },
          {
            "ar": "آلِهَةٌ",
            "en": "gods",
            "ref": "21:22",
            "verse": "لَوْ كَانَ فِيهِمَآ ءَالِهَةٌ إِلَّا ٱللَّهُ لَفَسَدَتَا ۚ فَسُبْحَـٰنَ ٱللَّهِ رَبِّ ٱلْعَرْشِ عَمَّا يَصِفُونَ",
            "verseEn": "Had there been within them [i.e., the heavens and earth] gods besides Allāh, they both would have been ruined. So exalted is Allāh, Lord of the Throne, above what they describe."
          },
          {
            "ar": "الْجِنَّ",
            "en": "the jinn",
            "ref": "34:41",
            "verse": "قَالُوا۟ سُبْحَـٰنَكَ أَنتَ وَلِيُّنَا مِن دُونِهِم ۖ بَلْ كَانُوا۟ يَعْبُدُونَ ٱلْجِنَّ ۖ أَكْثَرُهُم بِهِم مُّؤْمِنُونَ",
            "verseEn": "They will say, \"Exalted are You! You, [O Allāh], are our benefactor excluding [i.e., not] them. Rather, they used to worship the jinn; most of them were believers in them.\""
          },
          {
            "ar": "الشَّيْطَانُ",
            "en": "Shaitaan",
            "ref": "47:25",
            "verse": "إِنَّ ٱلَّذِينَ ٱرْتَدُّوا۟ عَلَىٰٓ أَدْبَـٰرِهِم مِّنۢ بَعْدِ مَا تَبَيَّنَ لَهُمُ ٱلْهُدَى ۙ ٱلشَّيْطَـٰنُ سَوَّلَ لَهُمْ وَأَمْلَىٰ لَهُمْ",
            "verseEn": "Indeed, those who reverted back [to disbelief] after guidance had become clear to them - Satan enticed them and prolonged hope for them."
          }
        ]
      },
      {
        "name": "أَمَاكِنُ وَاتِّجَاهَاتٌ مَكَانِيَّةٌ",
        "nameEn": "Spatial directions and locations",
        "color": "purple",
        "items": [
          {
            "ar": "السَّمَاوَاتِ",
            "en": "(of) the heavens",
            "ref": "44:7",
            "verse": "رَبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ",
            "verseEn": "Lord of the heavens and the earth and that between them, if you would be certain."
          },
          {
            "ar": "الْأَرْضِ",
            "en": "the land",
            "ref": "40:29",
            "verse": "يَـٰقَوْمِ لَكُمُ ٱلْمُلْكُ ٱلْيَوْمَ ظَـٰهِرِينَ فِى ٱلْأَرْضِ فَمَن يَنصُرُنَا مِنۢ بَأْسِ ٱللَّهِ إِن جَآءَنَا ۚ قَالَ فِرْعَوْنُ مَآ أُرِيكُمْ إِلَّا مَآ أَرَىٰ وَمَآ أَهْدِيكُمْ إِلَّا سَبِيلَ ٱلرَّشَادِ",
            "verseEn": "O my people, sovereignty is yours today, [your being] dominant in the land. But who would protect us from the punishment of Allāh if it came to us?\" Pharaoh said, \"I do not show you except what I see, and I do not guide you except to the way of right conduct.\""
          },
          {
            "ar": "الْيَمِينِ",
            "en": "the right",
            "ref": "70:37",
            "verse": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
            "verseEn": "[To sit] on [your] right and [your] left in separate groups?"
          },
          {
            "ar": "بَيْنَهُمْ",
            "en": "among them",
            "ref": "20:62",
            "verse": "فَتَنَـٰزَعُوٓا۟ أَمْرَهُم بَيْنَهُمْ وَأَسَرُّوا۟ ٱلنَّجْوَىٰ",
            "verseEn": "So they disputed over their affair among themselves and concealed their private conversation."
          }
        ]
      }
    ]
